{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document representing an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "User email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Avatar photo URL of the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "Person": {
      "title": "Person",
      "description": "Deaf contact person record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique contact ID."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated user owner ID."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of creator."
        },
        "lastUpdatedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of last modifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name or alias of the deaf person."
        },
        "photoRef": {
          "type": "string",
          "maxLength": 128,
          "description": "Reference identifier to stored photo asset."
        },
        "photoDataUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Compressed base64 data URL of the contact profile image."
        },
        "latitude": {
          "type": "number",
          "description": "Geographic latitude coordinate."
        },
        "longitude": {
          "type": "number",
          "description": "Geographic longitude coordinate."
        },
        "territoryId": {
          "type": "string",
          "maxLength": 128,
          "description": "Assigned territory ID."
        },
        "messengerUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Messenger profile link or URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record update timestamp."
        }
      },
      "required": ["id", "userId", "createdBy", "lastUpdatedBy", "name", "createdAt", "updatedAt"]
    },
    "Visit": {
      "title": "Visit",
      "description": "Visit note and interaction history with a contact.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique visit ID."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated user owner ID."
        },
        "personId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the person visited."
        },
        "visitedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date and time when the visit occurred."
        },
        "remarks": {
          "type": "string",
          "maxLength": 2000,
          "description": "Notes, discussion topics, or spiritual observations."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of creator."
        },
        "lastUpdatedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of last modifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record update timestamp."
        }
      },
      "required": ["id", "userId", "personId", "visitedAt", "remarks", "createdBy", "lastUpdatedBy", "createdAt", "updatedAt"]
    },
    "Territory": {
      "title": "Territory",
      "description": "Territory or zone definition for field contacts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique territory identifier."
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated user owner ID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Name or number of the territory."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of creator."
        },
        "lastUpdatedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of last modifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["id", "userId", "name", "createdBy", "lastUpdatedBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document containing account metadata."
    },
    "/users/{userId}/people/{personId}": {
      "schema": "Person",
      "description": "Contacts belonging to the authenticated user."
    },
    "/users/{userId}/visits/{visitId}": {
      "schema": "Visit",
      "description": "Visits and interaction history logged by the user."
    },
    "/users/{userId}/territories/{territoryId}": {
      "schema": "Territory",
      "description": "Territories configured by the user."
    }
  }
}
