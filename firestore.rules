rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test doc probe for client connection verification
    match /test/{docId} {
      allow get: if true;
    }

    // User profiles (private user profile data only)
    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.id == userId
        && data.email is string && data.email.size() <= 254
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      // Legacy per-user paths: preserve read/delete for migration safety; deny new writes
      match /people/{personId} {
        allow get, list, delete: if isOwner(userId);
        allow create, update: if false;
      }
      match /visits/{visitId} {
        allow get, list, delete: if isOwner(userId);
        allow create, update: if false;
      }
      match /territories/{territoryId} {
        allow get, list, delete: if isOwner(userId);
        allow create, update: if false;
      }
    }

    // ==========================================
    // CONGREGATION-WIDE SHARED ROOT COLLECTIONS
    // - Anyone can read (guests + authenticated users)
    // - Authenticated users can create, update, and delete
    // ==========================================

    match /people/{personId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(personId)
        && incoming().id == personId
        && incoming().createdBy == request.auth.uid
        && incoming().lastUpdatedBy == request.auth.uid
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && (!('photoRef' in incoming()) || incoming().photoRef == null || (incoming().photoRef is string && incoming().photoRef.size() <= 128))
        && (!('photoDataUrl' in incoming()) || incoming().photoDataUrl == null || (incoming().photoDataUrl is string && incoming().photoDataUrl.size() <= 400000))
        && (!('latitude' in incoming()) || incoming().latitude == null || (incoming().latitude is number && incoming().latitude >= -90.0 && incoming().latitude <= 90.0))
        && (!('longitude' in incoming()) || incoming().longitude == null || (incoming().longitude is number && incoming().longitude >= -180.0 && incoming().longitude <= 180.0))
        && (!('territoryId' in incoming()) || incoming().territoryId == null || (incoming().territoryId is string && isValidId(incoming().territoryId)))
        && (!('messengerUrl' in incoming()) || incoming().messengerUrl == null || (incoming().messengerUrl is string && incoming().messengerUrl.size() <= 500))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(personId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().lastUpdatedBy == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && (!('photoRef' in incoming()) || incoming().photoRef == null || (incoming().photoRef is string && incoming().photoRef.size() <= 128))
        && (!('photoDataUrl' in incoming()) || incoming().photoDataUrl == null || (incoming().photoDataUrl is string && incoming().photoDataUrl.size() <= 400000))
        && (!('latitude' in incoming()) || incoming().latitude == null || (incoming().latitude is number && incoming().latitude >= -90.0 && incoming().latitude <= 90.0))
        && (!('longitude' in incoming()) || incoming().longitude == null || (incoming().longitude is number && incoming().longitude >= -180.0 && incoming().longitude <= 180.0))
        && (!('territoryId' in incoming()) || incoming().territoryId == null || (incoming().territoryId is string && isValidId(incoming().territoryId)))
        && (!('messengerUrl' in incoming()) || incoming().messengerUrl == null || (incoming().messengerUrl is string && incoming().messengerUrl.size() <= 500))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'photoRef', 'photoDataUrl', 'latitude', 'longitude', 'territoryId', 'messengerUrl', 'lastUpdatedBy', 'updatedAt'
        ]);
      allow delete: if isSignedIn();
    }

    match /visits/{visitId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(visitId)
        && incoming().id == visitId
        && incoming().personId is string && isValidId(incoming().personId)
        && incoming().visitedAt is string && incoming().visitedAt.size() <= 50
        && incoming().remarks is string && incoming().remarks.size() <= 2000
        && incoming().createdBy == request.auth.uid
        && incoming().lastUpdatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(visitId)
        && incoming().id == existing().id
        && incoming().personId == existing().personId
        && incoming().createdBy == existing().createdBy
        && incoming().lastUpdatedBy == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().visitedAt is string && incoming().visitedAt.size() <= 50
        && incoming().remarks is string && incoming().remarks.size() <= 2000
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'visitedAt', 'remarks', 'lastUpdatedBy', 'updatedAt'
        ]);
      allow delete: if isSignedIn();
    }

    match /territories/{territoryId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(territoryId)
        && incoming().id == territoryId
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && incoming().createdBy == request.auth.uid
        && incoming().lastUpdatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(territoryId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().lastUpdatedBy == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'lastUpdatedBy', 'updatedAt'
        ]);
      allow delete: if isSignedIn();
    }
  }
}
